generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  DELEGATE
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PURCHASED
  SHIPPED_JORDAN
  SHIPPED_SYRIA
  DELIVERED
  CANCELLED
}

enum MarginCategory {
  NORMAL
  MEDIUM
  ADVANCED
  VERY_ADVANCED
}

enum EscrowStatus {
  HELD        // الأموال محتجزة لدى التطبيق
  RELEASED    // تم تسليم الأموال للمندوب
  REFUNDED    // تم إعادة الأموال للزبون
  DISPUTED    // هناك خلاف يحل من قبل الآدمن
}

model User {
  id             String    @id @default(uuid())
  googleSsoId    String?   @unique
  email          String    @unique
  passwordHash   String?
  fullName       String
  phone          String?
  address        String?
  avatar         String?
  role           Role      @default(USER)
  
  // Security & OTP
  isEmailVerified Boolean  @default(false)
  otpCode        String?
  otpExpiresAt   DateTime?
  otpType        String?   // "REGISTER", "RESET", "DELETE"
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?

  // Relations
  orders             Order[]
  notifications      Notification[]
  delegateProfile    DelegateProfile?
  wallet             Wallet?
  escrowPurchases    EscrowTransaction[] @relation("BuyerEscrow")
  products           Product[]           @relation("ProductOwner")
}

// ----------------------------------------
// DELEGATE & WALLET SYSTEM
// ----------------------------------------

model DelegateProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  storeName        String
  storeDescription String?
  rating           Float    @default(0.0)
  totalSales       Int      @default(0)
  isVerified       Boolean  @default(false) // Admin must verify delegates
  deliveryRules    String?  // شروط التوصيل الخاصة بالمندوب
  gpsLocation      String?
  storeAddress     String?
  signatureUrl     String?  // رابط لتوقيع المندوب الرقمي
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id])
}

model Wallet {
  id          String   @id @default(uuid())
  userId      String   @unique
  balanceSyp  Float    @default(0.0) // الرصيد المتاح القابل للسحب أو الشراء
  heldSyp     Float    @default(0.0) // الرصيد المحتجز (قيد الوساطة)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]
}

model WalletTransaction {
  id          String   @id @default(uuid())
  walletId    String
  amountSyp   Float
  type        String   // "DEPOSIT", "WITHDRAWAL", "ESCROW_HOLD", "ESCROW_RELEASE", "REFUND"
  description String?
  createdAt   DateTime @default(now())

  wallet      Wallet   @relation(fields: [walletId], references: [id])
}

model EscrowTransaction {
  id          String       @id @default(uuid())
  orderId     String       @unique
  buyerId     String
  delegateId  String
  amountSyp   Float
  status      EscrowStatus @default(HELD)
  createdAt   DateTime     @default(now())
  releasedAt  DateTime?

  buyer       User         @relation("BuyerEscrow", fields: [buyerId], references: [id])
  order       Order        @relation(fields: [orderId], references: [id])
}

// ----------------------------------------
// SHOP CORE
// ----------------------------------------

model AppSettings {
  id                    Int      @id @default(1)
  usdToSypRate          Float
  customsPercentage     Float
  shippingCostPerKg     Float
  expectedTransitDays   Int
  orderProcessingDays   Int      @default(2)
  profitMarginFixed     Float    @default(0.0)
  profitMarginPercent   Float    @default(0.0)
  updatedAt             DateTime @updatedAt
}

model Product {
  id                String   @id @default(uuid())
  nameEn            String
  nameAr            String
  descriptionEn     String?
  descriptionAr     String?
  sourcePriceUsd    Float
  weightKg          Float
  images            String[]
  isActive          Boolean  @default(true)
  sourceUrl         String?  // رابط المنتج الأصلي لشرائه من قبل الآدمن
  marginCategory    MarginCategory @default(NORMAL)
  
  // Delegate specific
  isDelegateProduct Boolean  @default(false)
  ownerId           String?  // Null means it's owned by HEQ Store officially

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  owner             User?    @relation("ProductOwner", fields: [ownerId], references: [id])
  orderItems        OrderItem[]
}

model Order {
  id                   String      @id @default(uuid())
  userId               String
  status               OrderStatus @default(PENDING)
  totalPriceSyp        Float
  totalPriceUsd        Float
  estimatedDeliveryDate DateTime
  jordanTrackingNumber String?
  syriaTrackingNumber  String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  appliedUsdToSypRate      Float
  appliedCustomsPercentage Float
  appliedShippingCostPerKg Float

  user                 User        @relation(fields: [userId], references: [id])
  items                OrderItem[]
  escrow               EscrowTransaction?
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  productId       String
  quantity        Int
  
  priceUsd        Float
  priceSyp        Float
  weightKg        Float

  order           Order    @relation(fields: [orderId], references: [id])
  product         Product  @relation(fields: [productId], references: [id])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  titleEn     String
  titleAr     String
  bodyEn      String
  bodyAr      String
  htmlContent String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
}
